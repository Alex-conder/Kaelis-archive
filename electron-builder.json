{
  "appId": "io.kaelis.workbench",
  "productName": "Kaelis AI Workbench",
  "directories": {
    "output": "../../release",
    "buildResources": "../../electron/assets"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../api",
      "to": "api",
      "filter": [
        "**/*",
        "!__pycache__",
        "!*.pyc",
        "!**/tests/**",
        "!**/test_*.py"
      ]
    },
    {
      "from": "../../core",
      "to": "core",
      "filter": [
        "**/*",
        "!__pycache__",
        "!*.pyc",
        "!**/tests/**",
        "!**/test_*.py",
        "!**/*.md"
      ]
    },
    {
      "from": "../../launch.py",
      "to": "launch.py"
    },
    {
      "from": "../../requirements.txt",
      "to": "requirements.txt"
    },
    {
      "from": "../../.env.example",
      "to": ".env.example"
    },
    {
      "from": "../../config",
      "to": "config",
      "filter": [
        "**/*",
        "!**/*.log",
        "!**/logs/**"
      ]
    },
    {
      "from": "../../electron/resources/python",
      "to": "python",
      "filter": [
        "python*.dll",
        "python*.exe",
        "python*.pth",
        "python3*.dll",
        "python.cat",
        "lib*.dll",
        "vcruntime*.dll",
        "sqlite3.dll",
        "get-pip.py",
        "Scripts/**",
        "Lib/**",
        "libs/**"
      ]
    },
    {
      "from": "../../electron/resources/backend",
      "to": "backend",
      "filter": [
        "**/*",
        "!**/*.log",
        "!**/logs/**"
      ]
    },
    {
      "from": "../../data",
      "to": "data",
      "filter": [
        "**/*",
        "!**/*.log",
        "!**/logs/**",
        "!**/*.tmp"
      ]
    }
  ],
  "asar": true,
  "publish": null,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "../../electron/assets/icon.ico"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "../../electron/assets/icon.icns",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "../../electron/assets/icon.png",
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kaelis AI Workbench"
  }
}