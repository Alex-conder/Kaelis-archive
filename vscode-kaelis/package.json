{
  "name": "kaelis",
  "displayName": "Kaelis Memory",
  "description": "Kaelis AI Agent — Your memory-enhanced coding companion with four-layer memory, skill market, and hallucination guard.",
  "version": "0.2.0",
  "publisher": "kaelis",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Data Science",
    "Snippets"
  ],
  "activationEvents": [
    "onChatParticipant:kaelis",
    "onView:kaelisSidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "kaelis",
        "name": "Kaelis",
        "fullName": "Kaelis Agent",
        "description": "AI agent with four-layer memory, self-evolution, multi-omics knowledge, and hallucination guard.",
        "isSticky": true,
        "commands": [
          {
            "name": "searchMemory",
            "description": "Search your Kaelis memory for relevant context"
          },
          {
            "name": "listSkills",
            "description": "List available skills in the Kaelis skill market"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kaelisContainer",
          "title": "Kaelis",
          "icon": "resources/kaelis-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "kaelisSidebarExplorer",
          "name": "Kaelis Memory",
          "when": "true",
          "icon": "resources/kaelis-icon.svg"
        }
      ],
      "kaelisContainer": [
        {
          "id": "kaelisSidebar",
          "name": "记忆中枢",
          "icon": "resources/kaelis-icon.svg",
          "contextualTitle": "Kaelis Memory"
        }
      ]
    },
    "commands": [
      {
        "command": "kaelis.saveToMemory",
        "title": "保存到 Kaelis",
        "category": "Kaelis",
        "icon": "$(save)"
      },
      {
        "command": "kaelis.searchMemory",
        "title": "搜索记忆",
        "category": "Kaelis",
        "icon": "$(search)"
      },
      {
        "command": "kaelis.refreshSidebar",
        "title": "刷新",
        "category": "Kaelis",
        "icon": "$(refresh)"
      },
      {
        "command": "kaelis.generateMcpConfig",
        "title": "生成 MCP 配置",
        "category": "Kaelis",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kaelis.saveToMemory",
          "group": "9_cutcopypaste@5",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "kaelis.refreshSidebar",
          "group": "navigation",
          "when": "view == kaelisSidebar"
        }
      ],
      "commandPalette": [
        {
          "command": "kaelis.saveToMemory",
          "when": "editorHasSelection"
        },
        {
          "command": "kaelis.searchMemory"
        },
        {
          "command": "kaelis.generateMcpConfig"
        }
      ]
    },
    "configuration": {
      "title": "Kaelis",
      "properties": {
        "kaelis.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to mcp_standalone.py (auto-detected if empty)"
        },
        "kaelis.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter path for MCP Server"
        },
        "kaelis.userId": {
          "type": "string",
          "default": "vscode_user",
          "description": "Your Kaelis user ID (used for memory isolation)"
        },
        "kaelis.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "Kaelis Flask API base URL (fallback when MCP unavailable)"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaelis/kaelis.git"
  },
  "bugs": {
    "url": "https://github.com/kaelis/kaelis/issues"
  },
  "homepage": "https://kaelis.ai",
  "license": "MIT",
  "icon": "resources/kaelis-icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "knowledge graph",
    "mcp",
    "chat",
    "hallucination guard"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.3.0"
  }
}
