# Kaelis Environment Configuration
# Auto-generated from config/env.schema.json
# Run `kaelis converge sync` to regenerate
#
# ⚠️  IMPORTANT: Never commit actual secrets to version control!

# ============================================================
# 核心服务配置
# ============================================================

# Flask 运行环境
# Options: development, production, testing
FLASK_ENV=development

# 是否开启调试模式
FLASK_DEBUG=True

# 服务监听端口
# Range: 1 - 65535
PORT=5000

# 服务监听地址
HOST=0.0.0.0

# Flask 密钥（用于 session 加密）
# REQUIRED
# SECRET - Do not commit actual value
SECRET_KEY=your_secret_key_here

# ============================================================
# 数据存储配置
# ============================================================

# 数据库连接 URL
# REQUIRED
# SECRET - Do not commit actual value
DATABASE_URL=your_database_url_here

# Redis 连接 URL
REDIS_URL=redis://localhost:6379/0

# ============================================================
# 外部服务配置
# ============================================================

# DeepSeek API 密钥
# SECRET - Do not commit actual value
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API 密钥
# SECRET - Do not commit actual value
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# 认证与同步配置 (Supabase)
# ============================================================

# Supabase 项目 URL
# REQUIRED for auth and cloud sync
SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名密钥 (Anon Key)
# SECRET - Do not commit actual value
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# 知识图谱配置 (Neo4j)
# ============================================================

# Neo4j 数据库 URI
# Format: neo4j://host:port or neo4j+s://host:port
NEO4J_URI=neo4j://localhost:7687

# Neo4j 用户名
NEO4J_USER=neo4j

# Neo4j 密码
# SECRET - Do not commit actual value
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================
# 性能调优配置
# ============================================================

# 最大工作线程数
# Range: 1 - 100
MAX_WORKERS=4

# 请求超时时间（秒）
# Range: 1 - 300
REQUEST_TIMEOUT=30

# 默认缓存超时时间（秒）
# Range: 0 - N/A
CACHE_DEFAULT_TIMEOUT=300

# ============================================================
# Other Variables
# ============================================================

# 缓存类型
CACHE_TYPE=simple

# 允许的 CORS 源（逗号分隔）
CORS_ORIGINS=*

# 是否启用遥测
ENABLE_TELEMETRY=True

# 日志级别
LOG_LEVEL=INFO

# API 速率限制
RATE_LIMIT=100/hour
