# Kaelis Environment Configuration
# Auto-generated from config/env.schema.json
# Run `kaelis converge sync` to regenerate
#
# ⚠️  IMPORTANT: Never commit actual secrets to version control!

# ============================================================
# 核心服务配置
# ============================================================

# Flask 运行环境
# Options: development, production, testing
FLASK_ENV=development

# 是否开启调试模式
FLASK_DEBUG=True

# 服务监听端口
# Range: 1 - 65535
PORT=5000

# 服务监听地址
HOST=0.0.0.0

# Flask 密钥（用于 session 加密）
# REQUIRED
# SECRET - Do not commit actual value
SECRET_KEY=your_secret_key_here

# ============================================================
# 数据存储配置
# ============================================================

# 数据库连接 URL
# REQUIRED
# SECRET - Do not commit actual value
DATABASE_URL=your_database_url_here

# Redis 连接 URL
REDIS_URL=redis://localhost:6379/0

# ============================================================
# LLM 大模型 API 配置（至少配置一项）
# ============================================================
# 获取方式：
#   DeepSeek: https://platform.deepseek.com/
#   OpenAI:   https://platform.openai.com/
#   Anthropic: https://console.anthropic.com/
#   通义千问: https://dashscope.aliyun.com/
#   智谱 GLM: https://open.bigmodel.cn/
#   Moonshot: https://platform.moonshot.cn/
#   讯飞星火: https://xinghuo.xfyun.cn/
#   百度文心: https://console.bce.baidu.com/
#   腾讯混元: https://console.cloud.tencent.com/
#   Ollama:   https://ollama.com/ (本地运行，无需 API Key)

# DeepSeek API 密钥
# SECRET - Do not commit actual value
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API 密钥
# SECRET - Do not commit actual value
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API 密钥
# SECRET - Do not commit actual value
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 通义千问 (DashScope) API 密钥
# SECRET - Do not commit actual value
QWEN_API_KEY=your_qwen_api_key_here

# 智谱 GLM API 密钥
# SECRET - Do not commit actual value
ZHIPU_API_KEY=your_zhipu_api_key_here

# Moonshot (Kimi) API 密钥
# SECRET - Do not commit actual value
MOONSHOT_API_KEY=your_moonshot_api_key_here

# 讯飞星火 API 密钥
# SECRET - Do not commit actual value
XUNFEI_API_KEY=your_xunfei_api_key_here

# 百度文心一言 API Key
# SECRET - Do not commit actual value
BAIDU_API_KEY=your_baidu_api_key_here

# 百度文心一言 Secret Key
# SECRET - Do not commit actual value
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# 腾讯混元 SecretId
# SECRET - Do not commit actual value
TENCENT_SECRET_ID=your_tencent_secret_id_here

# 腾讯混元 SecretKey
# SECRET - Do not commit actual value
TENCENT_API_KEY=your_tencent_api_key_here

# Ollama 本地服务地址（无需 API Key）
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 默认模型
OLLAMA_MODEL=llama3.1

# ============================================================
# 认证与同步配置 (Supabase)
# ============================================================

# Supabase 项目 URL
# REQUIRED for auth and cloud sync
SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名密钥 (Anon Key)
# SECRET - Do not commit actual value
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# 知识图谱配置 (Neo4j)
# ============================================================

# Neo4j 数据库 URI
# Format: neo4j://host:port or neo4j+s://host:port
NEO4J_URI=neo4j://localhost:7687

# Neo4j 用户名
NEO4J_USER=neo4j

# Neo4j 密码
# SECRET - Do not commit actual value
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================
# 性能调优配置
# ============================================================

# 最大工作线程数
# Range: 1 - 100
MAX_WORKERS=4

# 请求超时时间（秒）
# Range: 1 - 300
REQUEST_TIMEOUT=30

# 默认缓存超时时间（秒）
# Range: 0 - N/A
CACHE_DEFAULT_TIMEOUT=300

# ============================================================
# Other Variables
# ============================================================

# 缓存类型
CACHE_TYPE=simple

# 允许的 CORS 源（逗号分隔）
CORS_ORIGINS=*

# 是否启用遥测
ENABLE_TELEMETRY=True

# 日志级别
LOG_LEVEL=INFO

# API 速率限制
RATE_LIMIT=100/hour

# ============================================================
# Kaelis 运行时配置
# ============================================================

# WebSocket 服务端口号（默认 5001，多实例/测试时调整）
# KAELIS_WS_PORT=5001

# CredentialVault 主加密密钥（不设置则自动生成并保存到 ~/.kaelis/vault.key）
# SECRET - Do not commit actual value
# KAELIS_VAULT_KEY=your_vault_master_key_here

# Agent ID（用于权限系统中的匿名身份识别，空字符串表示未配置）
KAELIS_AGENT_ID=

# 基准测试模式（非空时启用中间件性能计时日志，仅用于开发/测试）
# BENCHMARK_MODE=1
