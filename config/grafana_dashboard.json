{
  "dashboard": {
    "title": "Kaelis 智流 AI Agent - 系统监控",
    "tags": ["kaelis", "ai-agent"],
    "timezone": "Asia/Shanghai",
    "schemaVersion": 36,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "系统状态",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "kaelis_uptime_seconds / 3600",
            "legendFormat": "运行时间 (小时)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "h",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "知识图谱实体数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "kg_entity_count",
            "legendFormat": "实体"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "知识图谱关系数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "kg_relation_count or kg_triple_count",
            "legendFormat": "关系"
          }
        ]
      },
      {
        "id": 4,
        "title": "KG 质量分",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "kg_quality_score",
            "legendFormat": "质量分"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 60},
                {"color": "green", "value": 80}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 5,
        "title": "KG 提取成功率",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(kg_extraction_total{status='success'}[5m]) / rate(kg_extraction_total[5m]) * 100",
            "legendFormat": "成功率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "KG 提取耗时分布",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 4},
        "targets": [
          {
            "expr": "rate(kg_extraction_duration_seconds_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ],
        "heatmap": {},
        "dataFormat": "tsbuckets"
      },
      {
        "id": 7,
        "title": "记忆各层记录数",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "memory_layer_records",
            "legendFormat": "{{layer}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "API 请求 QPS",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "rate(api_requests_total[1m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "API 请求延迟 P95",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 10,
        "title": "质检执行次数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "kg_inspection_total",
            "legendFormat": "{{check_type}}"
          }
        ]
      },
      {
        "id": 11,
        "title": "活跃请求数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 20},
        "targets": [
          {
            "expr": "api_active_requests",
            "legendFormat": "活跃请求"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "name": "告警",
          "datasource": "Prometheus",
          "expr": "kg_quality_score < 80",
          "tagKeys": "severity",
          "textFormat": "KG 质量分低于 80: {{value}}",
          "iconColor": "red"
        }
      ]
    }
  }
}
