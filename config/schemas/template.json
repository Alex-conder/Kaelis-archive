{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kaelis.dev/schemas/template.json",
  "title": "Kaelis Rule Template",
  "description": "Schema for Kaelis rule templates",
  "type": "object",
  "required": ["id", "name", "intent_patterns", "operations"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique template identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable template name"
    },
    "description": {
      "type": "string",
      "description": "Template description"
    },
    "intent_patterns": {
      "type": "array",
      "description": "Regex patterns to match user intent",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_intent": {
      "type": "object",
      "description": "Required fields in structured intent",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["add", "modify", "delete", "query", "deploy", "test", "migrate", "refactor", "configure"]
        },
        "target": {
          "type": "object",
          "properties": {
            "type": {"type": "string"},
            "path": {"type": "string"},
            "entity_name": {"type": "string"}
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "description": "List of operations to execute",
      "items": {
        "type": "object",
        "required": ["step", "type"],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "verify_file_exists",
              "create_file",
              "modify_file",
              "delete_file",
              "ast_inject",
              "ast_modify",
              "yaml_modify",
              "json_modify",
              "verify_syntax",
              "run_tests",
              "run_migration",
              "backup_file",
              "restore_backup"
            ]
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "pre_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "params": {"type": "object"}
            }
          }
        },
        "post_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "params": {"type": "object"}
            }
          }
        }
      }
    },
    "rollback_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "params": {"type": "object"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "discovered_at": {
          "type": "string",
          "format": "date-time"
        },
        "frequency": {
          "type": "integer",
          "minimum": 1
        },
        "success_count": {
          "type": "integer",
          "minimum": 0
        },
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string",
          "enum": ["pending_review", "approved", "deprecated"]
        },
        "source": {
          "type": "string",
          "enum": ["manual", "rule_learner", "team_shared"]
        },
        "author": {
          "type": "string"
        }
      }
    }
  }
}
