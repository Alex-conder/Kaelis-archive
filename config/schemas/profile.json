{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kaelis.dev/schemas/profile.json",
  "title": "Kaelis Developer Profile",
  "description": "Unified cognitive profile",
  "type": "object",
  "properties": {
    "developer_id": {"type": "string"},
    "last_updated": {"type": "string", "format": "date-time"},
    "work_patterns": {
      "type": "object",
      "properties": {
        "peak_hours": {"type": "array", "items": {"type": "integer"}},
        "preferred_tasks": {"type": "array", "items": {"type": "string"}},
        "common_mistakes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cognitive_load": {
      "type": "object",
      "properties": {
        "current": {"type": "number"},
        "trend": {"type": "string", "enum": ["increasing", "stable", "decreasing"]},
        "last_reset": {"type": "string", "format": "date-time"}
      }
    },
    "skill_matrix": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
