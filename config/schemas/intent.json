{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kaelis.dev/schemas/intent.json",
  "title": "Kaelis Intent",
  "description": "Unified structured intent for ACK v2.1",
  "type": "object",
  "required": ["version", "action", "target"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.1"]
    },
    "action": {
      "type": "string",
      "enum": ["add", "modify", "delete", "query", "deploy", "test", "migrate", "refactor", "configure"]
    },
    "target": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["api_route", "agent_tool", "config", "web_frontend", "database", "script", "test", "documentation", "domain_capability"]
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_/.-]+$"
        },
        "entity_name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "value": {"type": "string"},
          "severity": {"type": "string", "enum": ["must", "should", "nice_to_have"]}
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "original_query": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"},
        "session_id": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
