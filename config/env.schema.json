{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kaelis Environment Configuration Schema",
  "description": "定义所有环境变量的类型、约束和默认值。由 kaelis converge sync 自动维护。",
  "version": "1.0.0",
  "variables": {
    "FLASK_ENV": {
      "type": "string",
      "enum": ["development", "production", "testing"],
      "default": "development",
      "required": false,
      "description": "Flask 运行环境",
      "secret": false
    },
    "FLASK_DEBUG": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否开启调试模式",
      "secret": false
    },
    "PORT": {
      "type": "integer",
      "default": 5000,
      "min": 1,
      "max": 65535,
      "required": false,
      "description": "服务监听端口",
      "secret": false
    },
    "HOST": {
      "type": "string",
      "default": "0.0.0.0",
      "required": false,
      "description": "服务监听地址",
      "secret": false
    },
    "DATABASE_URL": {
      "type": "string",
      "required": true,
      "description": "数据库连接 URL",
      "secret": true,
      "example": "sqlite:///kaelis.db"
    },
    "REDIS_URL": {
      "type": "string",
      "default": "redis://localhost:6379/0",
      "required": false,
      "description": "Redis 连接 URL",
      "secret": false
    },
    "SECRET_KEY": {
      "type": "string",
      "required": true,
      "description": "Flask 密钥（用于 session 加密）",
      "secret": true,
      "minLength": 16
    },
    "DEEPSEEK_API_KEY": {
      "type": "string",
      "required": false,
      "description": "DeepSeek API 密钥",
      "secret": true
    },
    "OPENAI_API_KEY": {
      "type": "string",
      "required": false,
      "description": "OpenAI API 密钥",
      "secret": true
    },
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
      "default": "INFO",
      "required": false,
      "description": "日志级别",
      "secret": false
    },
    "MAX_WORKERS": {
      "type": "integer",
      "default": 4,
      "min": 1,
      "max": 100,
      "required": false,
      "description": "最大工作线程数",
      "secret": false
    },
    "REQUEST_TIMEOUT": {
      "type": "integer",
      "default": 30,
      "min": 1,
      "max": 300,
      "required": false,
      "description": "请求超时时间（秒）",
      "secret": false
    },
    "ENABLE_TELEMETRY": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "是否启用遥测",
      "secret": false
    },
    "CORS_ORIGINS": {
      "type": "string",
      "default": "*",
      "required": false,
      "description": "允许的 CORS 源（逗号分隔）",
      "secret": false
    },
    "RATE_LIMIT": {
      "type": "string",
      "default": "100/hour",
      "required": false,
      "description": "API 速率限制",
      "secret": false
    },
    "CACHE_TYPE": {
      "type": "string",
      "enum": ["simple", "redis", "filesystem"],
      "default": "simple",
      "required": false,
      "description": "缓存类型",
      "secret": false
    },
    "CACHE_DEFAULT_TIMEOUT": {
      "type": "integer",
      "default": 300,
      "min": 0,
      "required": false,
      "description": "默认缓存超时时间（秒）",
      "secret": false
    }
  },
  "groups": {
    "core": {
      "description": "核心服务配置",
      "variables": ["FLASK_ENV", "FLASK_DEBUG", "PORT", "HOST", "SECRET_KEY"]
    },
    "database": {
      "description": "数据存储配置",
      "variables": ["DATABASE_URL", "REDIS_URL"]
    },
    "external": {
      "description": "外部服务配置",
      "variables": ["DEEPSEEK_API_KEY", "OPENAI_API_KEY"]
    },
    "performance": {
      "description": "性能调优配置",
      "variables": ["MAX_WORKERS", "REQUEST_TIMEOUT", "CACHE_DEFAULT_TIMEOUT"]
    }
  },
  "validationRules": {
    "requireAtLeastOneOf": [
      ["DEEPSEEK_API_KEY", "OPENAI_API_KEY"]
    ],
    "mutuallyExclusive": [],
    "dependencies": {
      "CACHE_TYPE": {
        "if": "redis",
        "then": ["REDIS_URL"]
      }
    }
  }
}
