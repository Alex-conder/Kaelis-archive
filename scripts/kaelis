    def cmd_chaos(self, args):
        """Phase 8: 混沌工程"""
        import subprocess
        
        action = args.chaos_action or 'status'
        
        if action == 'inject':
            if not args.fault_type:
                print("Error: fault_type required")
                return 1
            cmd = ['python', 'scripts/chaos_verify.py', 'inject', args.fault_type, '--target', args.target]
            if args.duration:
                cmd.extend(['--duration', str(args.duration)])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'experiment':
            result = subprocess.run(['python', 'scripts/chaos_verify.py', 'experiment'])
            return result.returncode
        
        elif action == 'report':
            result = subprocess.run(['python', 'scripts/chaos_verify.py', 'report'])
            return result.returncode
        
        elif action == 'status':
            print("🔥 Kaelis 混沌工程状态")
            print("=" * 60)
            print("\n[可用故障类型]")
            print("  - network_partition: 网络分区")
            print("  - service_kill: 服务终止")
            print("  - resource_exhaustion: 资源耗尽")
            print("\n命令示例:")
            print("  kaelis chaos inject service_kill --target neo4j")
            print("  kaelis chaos experiment")
        
        return 0
    
    def cmd_optimize(self, args):
        """Phase 8: 认知负担优化"""
        import subprocess
        
        action = args.optimize_action or 'report'
        
        if action == 'analyze':
            result = subprocess.run(['python', 'scripts/cognitive_load_analyzer.py', 'analyze'])
            return result.returncode
        
        elif action == 'run':
            result = subprocess.run(['python', 'scripts/cognitive_load_analyzer.py', 'optimize'])
            return result.returncode
        
        elif action == 'recommend':
            cmd = ['python', 'scripts/cognitive_load_analyzer.py', 'recommend']
            if args.context:
                cmd.extend(['--context', args.context])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'report':
            result = subprocess.run(['python', 'scripts/cognitive_load_analyzer.py', 'report'])
            return result.returncode
        
        return 0
    
    def cmd_experience(self, args):
