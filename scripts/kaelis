        result = subprocess.run(cmd)
        return result.returncode
    
    def cmd_ai(self, args):
        """AI Native Development System (Phase 1)"""
        import subprocess
        
        action = args.ai_action or 'status'
        
        if action == 'status':
            result = subprocess.run(['python', 'scripts/kaelis_ai.py', 'status'])
            return result.returncode
        
        elif action == 'sync':
            result = subprocess.run(['python', 'scripts/kaelis_ai.py', 'sync'])
            return result.returncode
        
        elif action == 'query':
            if not args.ai_arg:
                print("Error: Query text required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_ai.py', 'query', args.ai_arg])
            return result.returncode
        
        elif action == 'search':
            if not args.ai_arg:
                print("Error: Symbol name required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_ai.py', 'search', args.ai_arg])
            return result.returncode
        
        elif action == 'impact':
            if not args.ai_arg:
                print("Error: File path required")
                return 1
            cmd = ['python', 'scripts/kaelis_ai.py', 'impact', args.ai_arg]
            if args.symbol:
                cmd.extend(['--symbol', args.symbol])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'risk':
            if not args.ai_arg:
                print("Error: File path required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_ai.py', 'risk', args.ai_arg])
            return result.returncode
        
        elif action == 'analyze':
            result = subprocess.run(['python', 'scripts/kaelis_ai.py', 'analyze'])
            return result.returncode
        
        return 0
    
    def cmd_debt(self, args):
        """技术债务治理 v2.0"""
        import subprocess
        
        action = args.debt_action or 'list'
        
        if action == 'list':
            cmd = ['python', 'scripts/kaelis_debt.py', 'list', '--sort', args.sort]
            if args.category:
                cmd.extend(['--category', args.category])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'show':
            if not args.debt_id:
                print("Error: debt_id required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_debt.py', 'show', args.debt_id])
            return result.returncode
        
        elif action == 'create':
            cmd = ['python', 'scripts/kaelis_debt.py', 'create', '--category', args.category or 'general']
            if args.title:
                cmd.extend(['--title', args.title])
            if args.symbol:
                cmd.extend(['--symbol', args.symbol])
            if args.file:
                cmd.extend(['--file', args.file])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'link':
            if not args.debt_id or not args.symbol or not args.file:
                print("Error: debt_id, --symbol, and --file required")
                return 1
            result = subprocess.run([
                'python', 'scripts/kaelis_debt.py', 'link', args.debt_id,
                '--symbol', args.symbol, '--file', args.file
            ])
            return result.returncode
        
        elif action == 'relink':
            result = subprocess.run(['python', 'scripts/kaelis_debt.py', 'relink'])
            return result.returncode
        
        elif action == 'verify':
            if not args.debt_id:
                print("Error: debt_id required")
                return 1
            cmd = ['python', 'scripts/kaelis_debt.py', 'verify', args.debt_id]
            if args.sandbox:
                cmd.append('--sandbox')
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'impact':
            if not args.debt_id:
                print("Error: debt_id required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_debt.py', 'impact', args.debt_id])
            return result.returncode
        
        elif action == 'suggest':
            if not args.debt_id:
                print("Error: debt_id required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_debt.py', 'suggest', args.debt_id])
            return result.returncode
        
        elif action == 'adopt':
            if not args.debt_id:
                print("Error: debt_id required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_debt.py', 'adopt', args.debt_id])
            return result.returncode
        
        elif action == 'resolve':
            if not args.debt_id:
                print("Error: debt_id required")
                return 1
            result = subprocess.run(['python', 'scripts/kaelis_debt.py', 'resolve', args.debt_id])
            return result.returncode
        
        return 0
    
    def _cmd_converge_ops(self, args):
        """Phase 4: 运维契约化子命令"""
        import subprocess
        
        ops_action = args.ops_action or 'status'
        
        if ops_action == 'status':
            print("🚀 Phase 4 - 运维契约化状态")
            print("=" * 60)
            print()
            print("[SLO 配置]")
            slo_file = Path("config/slo.yaml")
            print(f"  [{'✅' if slo_file.exists() else '❌'}] config/slo.yaml")
            print()
            print("[Prometheus 规则]")
            prom_file = Path("config/prometheus-rules.yaml")
            print(f"  [{'✅' if prom_file.exists() else '❌'}] config/prometheus-rules.yaml")
            print()
            print("[Grafana 仪表盘]")
            graf_file = Path("config/grafana-dashboard.json")
            print(f"  [{'✅' if graf_file.exists() else '❌'}] config/grafana-dashboard.json")
            print()
            print("[K8s 资源配额]")
            quota_file = Path("config/k8s-resource-quota.yaml")
            print(f"  [{'✅' if quota_file.exists() else '❌'}] config/k8s-resource-quota.yaml")
            print()
            print("[K8s HPA]")
            hpa_file = Path("config/k8s-hpa.yaml")
            print(f"  [{'✅' if hpa_file.exists() else '❌'}] config/k8s-hpa.yaml")
            print()
            print("[Docker Compose 校验]")
            print("  Run: kaelis converge ops validate")
            print()
            print("快速命令:")
            print("  kaelis converge ops generate      生成所有运维配置")
            print("  kaelis converge ops validate      校验 Docker Compose")
            print("  kaelis converge ops sync --full   全量同步（含运维配置）")
        
        elif ops_action == 'generate':
            print("🚀 Generating operations configurations...")
            print("=" * 60)
            result = subprocess.run(['python', 'scripts/ops_codegen.py', 'generate'])
            return result.returncode
        
        elif ops_action == 'validate':
            print("🔍 Validating Docker Compose environment variables...")
            print("=" * 60)
            result = subprocess.run(['python', 'scripts/ops_codegen.py', 'validate-compose'])
            return result.returncode
        
        elif ops_action == 'sync':
            scope = args.scope or 'all'
            
            if args.full:
                print("🚀 Full sync including operations configs...")
                print("=" * 60)
                print("\n1️⃣  Generating SLO configs...")
                subprocess.run(['python', 'scripts/ops_codegen.py', 'generate'])
                print("\n2️⃣  Validating Docker Compose...")
                subprocess.run(['python', 'scripts/ops_codegen.py', 'validate-compose'])
                print("\n3️⃣  Syncing application code...")
                subprocess.run(['python', 'scripts/sync_config.py', 'sync'])
                subprocess.run(['python', 'scripts/codegen_v2.py', 'backend', '--output', 'api/routes'])
                subprocess.run(['python', 'scripts/codegen_v2.py', 'frontend', '--output', 'web/frontend/src/api'])
                print("\n✅ Full sync complete!")
            else:
                print("🚀 Generating operations configurations...")
                subprocess.run(['python', 'scripts/ops_codegen.py', 'generate'])
        
        return 0


def create_parser():
    """创建参数解析器"""
    parser = argparse.ArgumentParser(
        prog='kaelis',
        description='Kaelis Unified CLI - Forward-Deterministic Kernel',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # 核心命令
  kaelis intent "Add API timeout configuration"
  kaelis intent "Create new database model" --dry-run
  kaelis plan "Add test case" --output plan.json
  kaelis execute plan.json

  # 操作命令
  kaelis op file add api/routes/auth.py --intent "Add login endpoint"
  kaelis op file update config/settings.yaml --intent "Update timeout"
  kaelis op env set DEBUG true

  # 会话与快照
  kaelis session start --intent "Refactor auth system"
  kaelis snapshot list
  kaelis snapshot rollback snapshot_20260101_120000

  # 认知
  kaelis profile              # View your cognitive profile
  kaelis guide                # Show navigation guide
  kaelis status               # System status

For more help: kaelis <command> --help
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # ------------------------------------------------------------------------
    # intent 命令
    # ------------------------------------------------------------------------
    intent_parser = subparsers.add_parser('intent', help='Process natural language intent')
    intent_parser.add_argument('description', help='Natural language description')
    intent_parser.add_argument('--dry-run', '-n', action='store_true', help='Validate only')
    intent_parser.add_argument('--skip-sandbox', action='store_true', help='Skip sandbox')
    
    # ------------------------------------------------------------------------
    # plan 命令
    # ------------------------------------------------------------------------
    plan_parser = subparsers.add_parser('plan', help='Generate execution plan')
    plan_parser.add_argument('description', help='Natural language description')
    plan_parser.add_argument('--output', '-o', help='Output file for plan')
    
    # ------------------------------------------------------------------------
    # execute 命令
    # ------------------------------------------------------------------------
    execute_parser = subparsers.add_parser('execute', help='Execute a plan')
    execute_parser.add_argument('plan_file', help='Plan JSON file')
    
    # ------------------------------------------------------------------------
    # op 命令
    # ------------------------------------------------------------------------
    op_parser = subparsers.add_parser('op', help='Atomic operations')
    op_subparsers = op_parser.add_subparsers(dest='op_command')
    
    # op file
    op_file = op_subparsers.add_parser('file', help='File operations')
    op_file.add_argument('file_action', choices=['add', 'update', 'delete'])
    op_file.add_argument('path', help='File path')
    op_file.add_argument('--intent', '-i', help='Intent description')
    op_file.add_argument('--dry-run', '-n', action='store_true')
    op_file.add_argument('--skip-sandbox', action='store_true')
    
    # op env
    op_env = op_subparsers.add_parser('env', help='Environment operations')
    op_env.add_argument('env_action', choices=['set', 'get', 'delete'])
    op_env.add_argument('key', help='Environment variable key')
    op_env.add_argument('value', nargs='?', help='Value (for set)')
    
    # ------------------------------------------------------------------------
    # session 命令
    # ------------------------------------------------------------------------
    session_parser = subparsers.add_parser('session', help='Session management')
    session_parser.add_argument('session_action', choices=['start', 'end', 'list'])
    session_parser.add_argument('--intent', help='Session intent')
    
    # ------------------------------------------------------------------------
    # snapshot 命令
    # ------------------------------------------------------------------------
    snapshot_parser = subparsers.add_parser('snapshot', help='Snapshot management')
    snapshot_parser.add_argument('snapshot_action', choices=['list', 'rollback'])
    snapshot_parser.add_argument('snapshot_id', nargs='?', help='Snapshot ID for rollback')
    
    # ------------------------------------------------------------------------
    # team 命令 (v2.0)
    # ------------------------------------------------------------------------
    team_parser = subparsers.add_parser('team', help='Team collaboration')
    team_parser.add_argument('team_action', choices=['init', 'sync', 'status'])
    team_parser.add_argument('remote_url', nargs='?', help='Remote repository URL')
    
    # ------------------------------------------------------------------------
    # template 命令 (v2.0)
    # ------------------------------------------------------------------------
    template_parser = subparsers.add_parser('template', help='Template management')
    template_parser.add_argument('template_action', choices=['list', 'approve', 'reject'])
    template_parser.add_argument('template_id', nargs='?', help='Template ID')
    template_parser.add_argument('--pending', action='store_true', help='Show pending templates')
    
    # ------------------------------------------------------------------------
    # symbols 命令 (v2.0)
    # ------------------------------------------------------------------------
    symbols_parser = subparsers.add_parser('symbols', help='Symbol index management')
    symbols_parser.add_argument('symbols_action', choices=['build', 'query'], nargs='?', default='build')
    symbols_parser.add_argument('--query', '-q', help='Query pattern (e.g., function:login)')
    symbols_parser.add_argument('--full', '-f', action='store_true', help='Full rebuild')
    
    # ------------------------------------------------------------------------
    # learn 命令 (v2.0)
    # ------------------------------------------------------------------------
    learn_parser = subparsers.add_parser('learn', help='Learn rules from sessions')
    learn_parser.add_argument('--min-frequency', '-f', type=int, default=3)
    learn_parser.add_argument('--min-success-rate', '-s', type=float, default=0.9)
    
    # ------------------------------------------------------------------------
    # 其他命令
    # ------------------------------------------------------------------------
    subparsers.add_parser('profile', help='View cognitive profile')
    subparsers.add_parser('guide', help='Show navigation guide')
    subparsers.add_parser('status', help='System status')
    
    # ------------------------------------------------------------------------
    # converge 命令 (v2.1 - Architecture Convergence)
    # ------------------------------------------------------------------------
    converge_parser = subparsers.add_parser(
        'converge',
        help='Architecture convergence and linkage correction',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis converge status          # Show convergence status
  kaelis converge sync            # Sync all modules
  kaelis converge sync --scope backend    # Sync backend only
  kaelis converge audit           # Run 通、达、速、省 audit
  kaelis converge check           # Check system consistency
  kaelis converge affected --file contracts/openapi.yaml
  kaelis converge validate        # Validate OpenAPI spec
  kaelis converge verify          # Bidirectional verification
  kaelis converge sync --full     # Full sync (backend+frontend+tests+docs+postman)
  kaelis converge sync --full --with-models  # Full sync including database models
        """
    )
    converge_parser.add_argument(
        'converge_action',
        choices=['status', 'sync', 'audit', 'check', 'affected', 'validate', 'verify', 'ops'],
        nargs='?',
        default='status'
    )
    converge_parser.add_argument(
        '--ops-action',
        choices=['status', 'generate', 'validate', 'sync'],
        default='status',
        help='Operations action (for converge ops)'
    )
    
    # ------------------------------------------------------------------------
    # knowledge 命令 (Phase 5 - Cognitive Exoskeleton)
    # ------------------------------------------------------------------------
    knowledge_parser = subparsers.add_parser(
        'knowledge',
        help='Knowledge management (Phase 5 - Cognitive Exoskeleton)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis knowledge                         # 显示知识管理状态
  kaelis knowledge adr create              # 创建架构决策记录
  kaelis knowledge adr list                # 列出所有 ADR
  kaelis knowledge fault record            # 记录故障经验
  kaelis knowledge fault lookup --file api/routes/kg.py
  kaelis knowledge linked-to api/routes/kg.py
  kaelis knowledge verify                  # 验证知识新鲜度
  kaelis knowledge daily                   # 每日认知简报
        """
    )
    knowledge_parser.add_argument(
        'knowledge_action',
        choices=['status', 'adr', 'fault', 'linked-to', 'verify', 'daily'],
        nargs='?',
        default='status'
    )
    knowledge_parser.add_argument('knowledge_sub_action', nargs='?', help='Sub-action for adr/fault')
    knowledge_parser.add_argument('knowledge_target', nargs='?', help='Target file for linked-to')
    knowledge_parser.add_argument('--id', dest='knowledge_id', help='Knowledge ID')
    converge_parser.add_argument(
        '--scope',
        choices=['all', 'backend', 'frontend', 'config'],
        default='all',
        help='Sync scope'
    )
    converge_parser.add_argument('--file', help='File to analyze')
    converge_parser.add_argument('--full', action='store_true', help='Full sync: backend+frontend+tests+docs+postman')
    converge_parser.add_argument('--with-models', action='store_true', help='Include SQLAlchemy models generation')
    converge_parser.add_argument('--fix', action='store_true', help='Auto-fix detected issues (used with verify)')
    
    # ------------------------------------------------------------------------
    # env 命令 (Phase 6 - Environment Contract)
    # ------------------------------------------------------------------------
    env_parser = subparsers.add_parser(
        'env',
        help='Environment contract management (Phase 6)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis env verify                        # 校验当前环境
  kaelis env verify --fix                  # 校验并自动修复
  kaelis env snapshot save                 # 保存环境快照
  kaelis env snapshot list                 # 列出环境快照
  kaelis env snapshot diff snap1 snap2     # 对比两个快照
  kaelis env generate devcontainer         # 生成 DevContainer 配置
        """
    )
    env_parser.add_argument(
        'env_action',
        choices=['verify', 'snapshot', 'generate'],
        nargs='?',
        default='verify'
    )
    env_parser.add_argument('env_sub_action', nargs='?', help='Sub-action')
    env_parser.add_argument('env_arg1', nargs='?', help='Argument 1')
    env_parser.add_argument('env_arg2', nargs='?', help='Argument 2')
    env_parser.add_argument('--fix', '-f', action='store_true', help='Auto-fix issues')
    env_parser.add_argument('--name', '-n', help='Snapshot name')
    
    # ------------------------------------------------------------------------
    # guard 命令 (Phase 7 - Agent Guard)
    # ------------------------------------------------------------------------
    guard_parser = subparsers.add_parser(
        'guard',
        help='AI output guard (Phase 7)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis guard check --file api/routes/kg.py   # 检查代码文件
  kaelis guard lsp start                       # 启动 LSP 服务器
  kaelis guard analyze                         # 分析护栏事件
        """
    )
    guard_parser.add_argument(
        'guard_action',
        choices=['check', 'lsp', 'analyze'],
        nargs='?',
        default='check'
    )
    guard_parser.add_argument('--file', '-f', help='File to check')
    guard_parser.add_argument('--code', '-c', help='Code string to check')
    guard_parser.add_argument('--mode', '-m', choices=['stdio', 'tcp'], default='stdio', help='LSP mode')
    
    # ------------------------------------------------------------------------
    # decision 命令 (Phase 5 重构 - Decision Contract)
    # ------------------------------------------------------------------------
    decision_parser = subparsers.add_parser(
        'decision',
        help='Decision contract management (Phase 5)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis decision create                    # 创建决策契约
  kaelis decision create --auto             # 自动创建
  kaelis decision activate DEC-20260413-001 # 激活决策
  kaelis decision verify                    # 校验约束
  kaelis decision list                      # 列出决策
  kaelis decision expired                   # 查看过期决策
  kaelis decision migrate ADR-20260413-001  # 从 ADR 迁移
  kaelis decision deprecate DEC-20260413-001 # 废弃决策
        """
    )
    decision_parser.add_argument(
        'decision_action',
        choices=['create', 'activate', 'verify', 'list', 'expired', 'migrate', 'deprecate'],
        nargs='?',
        default='list'
    )
    decision_parser.add_argument('decision_id', nargs='?', help='Decision ID or ADR ID')
    decision_parser.add_argument('--status', '-s', choices=['proposed', 'active', 'deprecated'])
    decision_parser.add_argument('--auto', '-a', action='store_true', help='Auto-create without interaction')
    decision_parser.add_argument('--reason', '-r', help='Reason for deprecation')
    
    # ------------------------------------------------------------------------
    # Phase 8: Runtime Infrastructure
    # ------------------------------------------------------------------------
    
    # runtime 命令
    runtime_parser = subparsers.add_parser('runtime', help='Runtime API service (Phase 8)')
    runtime_parser.add_argument('runtime_action', choices=['start', 'status'], nargs='?', default='status')
    runtime_parser.add_argument('--host', default='0.0.0.0')
    runtime_parser.add_argument('--port', type=int, default=5001)
    runtime_parser.add_argument('--reload', action='store_true')
    
    # slo 命令
    slo_parser = subparsers.add_parser('slo', help='SLO runtime validation (Phase 8)')
    slo_parser.add_argument('slo_action', choices=['check', 'monitor', 'report', 'simulate'], nargs='?', default='check')
    slo_parser.add_argument('--service', '-s')
    slo_parser.add_argument('--interval', '-i', type=int)
    
    # drift 命令
    drift_parser = subparsers.add_parser('drift', help='Semantic drift detection (Phase 8)')
    drift_parser.add_argument('drift_action', choices=['check', 'evaluate', 'report', 'simulate'], nargs='?', default='check')
    
    # chaos 命令
    chaos_parser = subparsers.add_parser('chaos', help='Chaos engineering (Phase 8)')
    chaos_parser.add_argument('chaos_action', choices=['status', 'inject', 'experiment', 'report'], nargs='?', default='status')
    chaos_parser.add_argument('fault_type', nargs='?', choices=['network_partition', 'service_kill', 'resource_exhaustion'])
    chaos_parser.add_argument('--target', '-t')
    chaos_parser.add_argument('--duration', '-d', type=int)
    
    # optimize 命令
    optimize_parser = subparsers.add_parser('optimize', help='Cognitive optimization (Phase 8)')
    optimize_parser.add_argument('optimize_action', choices=['analyze', 'run', 'recommend', 'report'], nargs='?', default='report')
    optimize_parser.add_argument('--context', '-c')
    
    # ------------------------------------------------------------------------
    # experience 命令 (KECL - Kaelis Experience Contract Language)
    # ------------------------------------------------------------------------
    exp_parser = subparsers.add_parser(
        'experience',
        help='Run user experience journey (KECL)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis experience first_time_user    # New user initialization
  kaelis experience dev_quickstart     # Developer quick start
  kaelis experience --list             # List all journeys
        """
    )
    exp_parser.add_argument('journey', nargs='?', default='first_time_user', help='Journey name')
    exp_parser.add_argument('--list', '-l', action='store_true', help='List available journeys')
    
    # ------------------------------------------------------------------------
    # codegen 命令 (v2.1 - Code Generation)
    # ------------------------------------------------------------------------
    codegen_parser = subparsers.add_parser(
        'codegen',
        help='Generate code from OpenAPI specification'
    )
    codegen_parser.add_argument(
        'target',
        choices=['backend', 'frontend'],
        help='Generation target'
    )
    codegen_parser.add_argument('--output', '-o', help='Output directory')
    
    # ------------------------------------------------------------------------
    # ai 命令 (AI Native Development System)
    # ------------------------------------------------------------------------
    ai_parser = subparsers.add_parser(
        'ai',
        help='AI Native Development System (Phase 1)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis ai status                    # 查看 AI 服务状态
  kaelis ai sync                      # 同步 AI 上下文文件
  kaelis ai query "M0 规则有哪些？"   # 自然语言查询
  kaelis ai search UserService        # 符号搜索
  kaelis ai impact api/services/order.py  # 影响分析
  kaelis ai risk api/routes/users.py  # 风险评分
  kaelis ai analyze                   # 分析阻断模式
        """
    )
    ai_parser.add_argument(
        'ai_action',
        choices=['status', 'sync', 'query', 'search', 'impact', 'risk', 'analyze'],
        nargs='?',
        default='status'
    )
    ai_parser.add_argument('ai_arg', nargs='?', help='Argument for query/search/impact/risk')
    ai_parser.add_argument('--symbol', '-s', help='Symbol name for impact analysis')
    
    # ------------------------------------------------------------------------
    # debt 命令 (技术债务治理 v2.0)
    # ------------------------------------------------------------------------
    debt_parser = subparsers.add_parser(
        'debt',
        help='Technical debt governance v2.0',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kaelis debt list --sort impact      # 按影响评分排序
  kaelis debt show TD-20260101-001    # 查看债务详情
  kaelis debt create --title "..." --category api --symbol X --file path
  kaelis debt link TD-001 --symbol X --file path  # 关联符号（自动指纹）
  kaelis debt relink                  # 重构后重新匹配
  kaelis debt verify TD-001 --sandbox # 验证债务
  kaelis debt impact TD-001           # 查看影响评分
  kaelis debt suggest TD-001          # 生成AI建议
  kaelis debt adopt TD-001            # 采纳建议
  kaelis debt resolve TD-001          # 解决债务
        """
    )
    debt_parser.add_argument(
        'debt_action',
        choices=['list', 'show', 'create', 'link', 'relink', 'verify', 'impact', 'suggest', 'adopt', 'resolve'],
        nargs='?',
        default='list'
    )
    debt_parser.add_argument('debt_id', nargs='?', help='Debt ID')
    debt_parser.add_argument('--sort', choices=['impact', 'date'], default='impact', help='Sort order')
    debt_parser.add_argument('--category', help='Filter by category')
    debt_parser.add_argument('--title', help='Debt title (for create)')
    debt_parser.add_argument('--symbol', help='Symbol name')
    debt_parser.add_argument('--file', help='File path')
    debt_parser.add_argument('--sandbox', action='store_true', help='Use sandbox mode')
    
    return parser


def check_project_identity():
    """校验项目身份"""
    identity_file = Path(".kaelis/project_identity.json")
    if not identity_file.exists():
        print("[ERR] Current directory is not a Kaelis project root.")
        print("      Please switch to a directory containing .kaelis/project_identity.json")
        print("      or run 'python scripts/init_identity.py' to initialize.")
        return False
    
    try:
        import json
        with open(identity_file) as f:
            identity = json.load(f)
        if identity.get("project") != "Kaelis":
            print(f"[ERR] Invalid project identity: {identity.get('project')}")
            return False
        return True
    except json.JSONDecodeError:
        print("[ERR] Invalid project_identity.json format")
        return False


def main():
    parser = create_parser()
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 0
    
    # 项目身份校验 (在运行命令前)
    if not check_project_identity():
        return 1
    
    cli = KaelisCLI()
    
    # 路由到对应命令
    command_map = {
        'intent': cli.cmd_intent,
        'plan': cli.cmd_plan,
        'execute': cli.cmd_execute,
        'op': lambda a: cli.cmd_op_file(a) if a.op_command == 'file' else cli.cmd_op_env(a),
        'session': cli.cmd_session,
        'snapshot': cli.cmd_snapshot,
        'profile': cli.cmd_profile,
        'guide': cli.cmd_guide,
        'status': cli.cmd_status,
        'team': cli.cmd_team,
        'template': cli.cmd_template,
        'symbols': cli.cmd_symbols,
        'learn': cli.cmd_learn,
        'converge': cli.cmd_converge,
        'codegen': cli.cmd_codegen,
        'knowledge': cli.cmd_knowledge,
        'env': cli.cmd_env,
        'guard': cli.cmd_guard,
        'decision': cli.cmd_decision,
        'runtime': cli.cmd_runtime,
        'slo': cli.cmd_slo,
        'drift': cli.cmd_drift,
        'chaos': cli.cmd_chaos,
        'optimize': cli.cmd_optimize,
        'ai': cli.cmd_ai,
        'debt': cli.cmd_debt,
        'experience': cli.cmd_experience,
    }
    
    handler = command_map.get(args.command)
    if handler:
        return handler(args)
    else:
        print(f"Unknown command: {args.command}")
        return 1


if __name__ == '__main__':
    sys.exit(main())
