#!/usr/bin/env python3
"""
Kaelis 统一 CLI 入口 v1.0
以 ACK v2.1 前馈确定性内核为统一基准

使用方式:
  kaelis intent "<自然语言目标>"          # 启动完整前馈流水线
  kaelis plan "<目标>"                   # 仅生成计划，不执行
  kaelis execute <plan-id>               # 执行已审批的计划
  
  kaelis op file add <path> --intent "..."
  kaelis op env set <key> <value>
  
  kaelis session start --intent "..."
  kaelis snapshot rollback <id>
  
  kaelis profile                          # 查看认知画像
  kaelis guide                            # 获取导航建议

作者: Kaelis Unified Architecture
版本: 1.0.0
"""

import os
import sys
import argparse
import json
from pathlib import Path
from datetime import datetime

# 确保可以导入 scripts 目录下的模块
SCRIPT_DIR = Path(__file__).parent
sys.path.insert(0, str(SCRIPT_DIR))

# 尝试导入 ACK v2.1 组件
try:
    from idea_factory_v2 import IdeaFactoryV2
    from rule_engine import RuleEngine
    from hallucination_detector import HallucinationDetector
    from sandbox_runner import SandboxRunner
    from atomic_executor import AtomicExecutor
    ACK_AVAILABLE = True
except ImportError as e:
    print(f"[WARN] ACK components not fully available: {e}")
    ACK_AVAILABLE = False

# 常量
CONFIG_FILE = Path("config/kaelis.yaml")
VERSION = "1.0.0"


def load_config():
    """加载主配置"""
    import yaml
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
            return yaml.safe_load(f)
    return {}


class KaelisCLI:
    """Kaelis 统一 CLI"""
    
    def __init__(self):
        self.config = load_config()
        self.factory = IdeaFactoryV2() if ACK_AVAILABLE else None
    
    # ========================================================================
    # 核心命令: intent
    # ========================================================================
    def cmd_intent(self, args):
        """处理自然语言意图"""
        if not self.factory:
            print("[ERROR] ACK v2.1 not available")
            return 1
        
        description = args.description
        dry_run = args.dry_run
        skip_sandbox = args.skip_sandbox
        
        print(f"\n[Kaelis] Processing intent: {description}")
        print("=" * 60)
        
        success = self.factory.process(description, dry_run=dry_run, skip_sandbox=skip_sandbox)
        
        return 0 if success else 1
    
    # ========================================================================
    # 核心命令: plan
    # ========================================================================
    def cmd_plan(self, args):
        """仅生成执行计划"""
        if not self.factory:
            print("[ERROR] ACK v2.1 not available")
            return 1
        
        description = args.description
        
        print(f"\n[Kaelis] Generating plan for: {description}")
        print("=" * 60)
        
        # 解析意图
        from idea_factory_v2 import IntentParser
        parser = IntentParser()
        intent = parser.parse(description)
        
        if not intent:
            print("[FAIL] Failed to parse intent")
            return 1
        
        # 匹配规则
        engine = RuleEngine()
        template, matches = engine.match_intent(intent)
        
        if not template:
            print("[FAIL] No matching template found")
            print(engine.get_no_match_guidance())
            return 1
        
        # 生成计划
        plan = engine.generate_execution_plan(template, intent)
        
        # 输出
        output_file = args.output
        if output_file:
            with open(output_file, 'w') as f:
                json.dump(plan, f, indent=2, ensure_ascii=False)
            print(f"[OK] Plan saved to: {output_file}")
        else:
            print("\nGenerated Plan:")
            print(json.dumps(plan, indent=2, ensure_ascii=False))
        
        return 0
    
    # ========================================================================
    # 核心命令: execute
    # ========================================================================
    def cmd_execute(self, args):
        """执行已生成的计划"""
        plan_file = args.plan_file
        
        if not Path(plan_file).exists():
            print(f"[ERROR] Plan file not found: {plan_file}")
            return 1
        
        with open(plan_file, 'r') as f:
            plan = json.load(f)
        
        print(f"\n[Kaelis] Executing plan: {plan.get('template_name', 'Unknown')}")
        print("=" * 60)
        
        executor = AtomicExecutor()
        try:
            record = executor.execute(plan)
            print(f"[OK] Execution successful: {record.execution_id}")
            return 0
        except Exception as e:
            print(f"[FAIL] Execution failed: {e}")
            return 1
    
    # ========================================================================
    # 操作命令: op file
    # ========================================================================
    def cmd_op_file(self, args):
        """文件操作"""
        action = args.file_action  # add, update, delete
        path = args.path
        intent_desc = args.intent
        
        # 构建意图
        action_map = {
            'add': 'add',
            'update': 'modify',
            'delete': 'delete'
        }
        
        intent_action = action_map.get(action, action)
        
        if not intent_desc:
            intent_desc = f"{action} file {path}"
        
        # 构建完整描述
        full_desc = f"{intent_action} {path}: {intent_desc}"
        
        # 复用 intent 命令
        class Args:
            pass
        
        intent_args = Args()
        intent_args.description = full_desc
        intent_args.dry_run = args.dry_run
        intent_args.skip_sandbox = args.skip_sandbox
        
        return self.cmd_intent(intent_args)
    
    # ========================================================================
    # 操作命令: op env
    # ========================================================================
    def cmd_op_env(self, args):
        """环境变量操作"""
        action = args.env_action  # set, get, delete
        
        if action == 'set':
            key = args.key
            value = args.value
            print(f"[Kaelis] Setting env: {key}={value}")
            # 实际实现需要修改 .env 文件
            return 0
        elif action == 'get':
            key = args.key
            print(f"[Kaelis] Getting env: {key}")
            return 0
        
        return 0
    
    # ========================================================================
    # 会话命令
    # ========================================================================
    def cmd_session(self, args):
        """会话管理"""
        action = args.session_action  # start, end, list
        
        if action == 'start':
            intent = args.intent
            session_id = f"sess_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
            print(f"[Kaelis] Session started: {session_id}")
            if intent:
                print(f"  Intent: {intent}")
            return 0
        
        elif action == 'end':
            print("[Kaelis] Session ended")
            return 0
        
        elif action == 'list':
            print("[Kaelis] Active sessions:")
            # 列出会话
            return 0
        
        return 0
    
    # ========================================================================
    # 快照命令
    # ========================================================================
    def cmd_snapshot(self, args):
        """快照管理"""
        action = args.snapshot_action  # list, rollback
        
        if action == 'list':
            print("[Kaelis] Available snapshots:")
            snapshots_dir = Path(".kaelis/snapshots")
            if snapshots_dir.exists():
                for snap in sorted(snapshots_dir.glob("snapshot_*")):
                    print(f"  - {snap.name}")
            return 0
        
        elif action == 'rollback':
            snapshot_id = args.snapshot_id
            print(f"[Kaelis] Rolling back to: {snapshot_id}")
            # 调用回滚逻辑
            return 0
        
        return 0
    
    # ========================================================================
    # 认知命令
    # ========================================================================
    def cmd_profile(self, args):
        """查看认知画像"""
        print("[Kaelis] Developer Profile")
        print("=" * 60)
        
        profile_file = Path(".kaelis/profile.json")
        if profile_file.exists():
            with open(profile_file, 'r') as f:
                profile = json.load(f)
            print(json.dumps(profile, indent=2))
        else:
            print("No profile data available yet.")
            print("Profile is built from your operation history over time.")
        
        return 0
    
    def cmd_guide(self, args):
        """获取导航建议"""
        print("[Kaelis] Navigation Guide")
        print("=" * 60)
        print("""
Quick Start:
  kaelis intent "Add API timeout configuration"
  kaelis intent "Create new database model"
  kaelis intent "Add test case for auth module"

Operations:
  kaelis op file add api/routes/new.py --intent "Add endpoint"
  kaelis op env set DEBUG true

Session & Snapshot:
  kaelis session start --intent "Refactor auth system"
  kaelis snapshot rollback snapshot_20260101_120000

Cognitive:
  kaelis profile              # View your cognitive profile
  kaelis guide                # Show this guide
        """)
        return 0
    
    # ========================================================================
    # 状态命令
    # ========================================================================
    def cmd_status(self, args):
        """系统状态"""
        print("[Kaelis] System Status")
        print("=" * 60)
        print(f"Version: {VERSION}")
        print(f"ACK v2.1 Available: {'Yes' if ACK_AVAILABLE else 'No'}")
        
        # 检查组件
        components = [
            ("config/kaelis.yaml", "Main Config"),
            ("config/intent_schema.json", "Intent Schema"),
            ("config/action_templates.yaml", "Action Templates"),
            ("scripts/idea_factory_v2.py", "Idea Factory v2"),
            ("scripts/rule_engine.py", "Rule Engine"),
            ("scripts/hallucination_detector.py", "Hallucination Detector"),
            ("scripts/sandbox_runner.py", "Sandbox Runner"),
            ("scripts/atomic_executor.py", "Atomic Executor"),
        ]
        
        print("\nComponents:")
        for path, name in components:
            status = "[OK]" if Path(path).exists() else "[MISSING]"
            print(f"  {status} {name}")
        
        # 数据目录
        print("\nData Directories:")
        for dir_name in [".kaelis/audit", ".kaelis/snapshots", ".kaelis/sessions"]:
            exists = Path(dir_name).exists()
            status = "[OK]" if exists else "[MISSING]"
            print(f"  {status} {dir_name}")
        
        # v2.0 新增状态
        print("\nv2.0 Features:")
        team_dir = Path(".kaelis-team/.git")
        print(f"  [{'OK' if team_dir.exists() else 'PENDING'}] Team Repository")
        
        symbol_file = Path(".kaelis/symbols/symbols.json")
        print(f"  [{'OK' if symbol_file.exists() else 'PENDING'}] Symbol Index")
        
        pending_dir = Path("config/templates/pending")
        pending_count = len(list(pending_dir.glob("*.yaml"))) if pending_dir.exists() else 0
        print(f"  [{'OK' if pending_count == 0 else 'PENDING'}] Pending Templates ({pending_count})")
        
        return 0
    
    # ========================================================================
    # v2.0 新增命令
    # ========================================================================
    
    def cmd_team(self, args):
        """团队命令"""
        import subprocess
        
        action = args.team_action
        
        if action == 'init':
            cmd = ['python', 'scripts/team_sync.py', 'init']
            if args.remote_url:
                cmd.append(args.remote_url)
            subprocess.run(cmd)
        elif action == 'sync':
            subprocess.run(['python', 'scripts/team_sync.py', 'sync'])
        elif action == 'status':
            subprocess.run(['python', 'scripts/team_sync.py', 'status'])
        
        return 0
    
    def cmd_template(self, args):
        """模板命令"""
        action = args.template_action
        
        if action == 'list':
            pending = args.pending
            if pending or not args.template_id:
                print("Pending Templates:")
                pending_dir = Path("config/templates/pending")
                if pending_dir.exists():
                    for f in sorted(pending_dir.glob("*.yaml")):
                        print(f"  - {f.stem}")
                else:
                    print("  (none)")
            else:
                print("Approved Templates:")
                approved_dir = Path("config/templates/approved")
                if approved_dir.exists():
                    for f in sorted(approved_dir.glob("*.yaml")):
                        print(f"  - {f.stem}")
        
        elif action == 'approve':
            if not args.template_id:
                print("Error: template_id required")
                return 1
            pending_file = Path(f"config/templates/pending/{args.template_id}.yaml")
            approved_dir = Path("config/templates/approved")
            approved_dir.mkdir(parents=True, exist_ok=True)
            
            if pending_file.exists():
                import shutil
                shutil.move(pending_file, approved_dir / pending_file.name)
                print(f"[OK] Template {args.template_id} approved")
            else:
                print(f"[ERROR] Template not found: {pending_file}")
                return 1
        
        return 0
    
    def cmd_symbols(self, args):
        """符号命令"""
        import subprocess
        
        action = args.symbols_action or 'build'
        
        if action == 'build':
            cmd = ['python', 'scripts/symbol_indexer.py']
            if args.full:
                cmd.append('--full')
            subprocess.run(cmd)
        elif action == 'query':
            if not args.query:
                print("Error: --query required for query action")
                return 1
            subprocess.run(['python', 'scripts/symbol_indexer.py', '--query', args.query])
        
        return 0
    
    def cmd_learn(self, args):
        """学习命令"""
        import subprocess
        
        cmd = [
            'python', 'scripts/rule_learner.py',
            '--min-frequency', str(args.min_frequency),
            '--min-success-rate', str(args.min_success_rate)
        ]
        subprocess.run(cmd)
        return 0
    
    # ========================================================================
    # v2.1 架构收敛命令 (Schema-Driven Linkage System)
    # ========================================================================
    
    def cmd_knowledge(self, args):
        """Phase 5: 知识管理命令"""
        import subprocess
        
        action = args.knowledge_action or 'status'
        
        if action == 'status':
            print("🧠 Phase 5 - 认知外骨骼状态")
            print("=" * 60)
            print()
            
            # 检查 ADR
            adr_dir = Path(".kaelis/adr")
            adr_count = len(list(adr_dir.glob("ADR-*.json"))) if adr_dir.exists() else 0
            print(f"[ADR 架构决策记录]")
            print(f"  [{'✅' if adr_count > 0 else '❌'}] 已创建 {adr_count} 个 ADR")
            print()
            
            # 检查故障知识库
            kb_file = Path(".kaelis/fault-kb.jsonl")
            fault_count = 0
            if kb_file.exists():
                fault_count = len([l for l in kb_file.read_text().split('\n') if l.strip()])
            print(f"[故障知识库]")
            print(f"  [{'✅' if fault_count > 0 else '❌'}] 已记录 {fault_count} 个故障")
            print()
            
            # 检查知识链接
            links_file = Path(".kaelis/knowledge_links.json")
            print(f"[知识链接]")
            print(f"  [{'✅' if links_file.exists() else '❌'}] 知识-代码符号链接")
            print()
            
            print("快速命令:")
            print("  kaelis knowledge adr create        创建 ADR")
            print("  kaelis knowledge adr list          列出 ADR")
            print("  kaelis knowledge fault record      记录故障")
            print("  kaelis knowledge fault lookup      查询故障")
            print("  kaelis knowledge linked-to <file>  查询文件关联知识")
            print("  kaelis knowledge verify            验证知识新鲜度")
            print("  kaelis knowledge daily             每日认知简报")
        
        elif action == 'adr':
            sub_action = args.knowledge_sub_action or 'list'
            
            if sub_action == 'create':
                result = subprocess.run(['python', 'scripts/adr_wizard.py', 'create'])
                return result.returncode
            elif sub_action == 'list':
                result = subprocess.run(['python', 'scripts/adr_wizard.py', 'list'])
                return result.returncode
            elif sub_action == 'show':
                if not args.knowledge_id:
                    print("Error: --id required")
                    return 1
                result = subprocess.run(['python', 'scripts/adr_wizard.py', 'show', args.knowledge_id])
                return result.returncode
        
        elif action == 'fault':
            sub_action = args.knowledge_sub_action or 'list'
            
            if sub_action == 'record':
                result = subprocess.run(['python', 'scripts/fault_kb.py', 'record'] + sys.argv[4:])
                return result.returncode
            elif sub_action == 'lookup':
                result = subprocess.run(['python', 'scripts/fault_kb.py', 'lookup'] + sys.argv[4:])
                return result.returncode
            elif sub_action == 'stats':
                result = subprocess.run(['python', 'scripts/fault_kb.py', 'stats'])
                return result.returncode
            elif sub_action == 'list':
                result = subprocess.run(['python', 'scripts/fault_kb.py', 'list'])
                return result.returncode
        
        elif action == 'linked-to':
            if not args.knowledge_target:
                print("Error: file path required")
                return 1
            result = subprocess.run(['python', 'scripts/knowledge_connector.py', 'linked-to', args.knowledge_target])
            return result.returncode
        
        elif action == 'verify':
            result = subprocess.run(['python', 'scripts/knowledge_verifier.py', 'verify'])
            return result.returncode
        
        elif action == 'daily':
            result = subprocess.run(['python', 'scripts/cognitive_navigator.py', 'daily'])
            return result.returncode
        
        return 0
    
    def cmd_converge(self, args):
        """架构收敛命令"""
        import subprocess
        from pathlib import Path
        
        action = args.converge_action or 'status'
        
        # Phase 4: 运维契约化子命令
        if action == 'ops':
            return self._cmd_converge_ops(args)
        
        if action == 'status':
            print("🏗️  Kaelis Architecture Convergence Status")
            print("=" * 60)
            print()
            print("[单一事实源]")
            openapi = Path("contracts/openapi.yaml")
            print(f"  [{'✅' if openapi.exists() else '❌'}] OpenAPI Specification")
            print()
            print("[代码生成器]")
            codegen = Path("scripts/codegen.py")
            print(f"  [{'✅' if codegen.exists() else '❌'}] Code Generator")
            print()
            print("[依赖图谱]")
            dep_graph = Path("scripts/dependency_graph.py")
            print(f"  [{'✅' if dep_graph.exists() else '❌'}] Dependency Graph Engine")
            print()
            print("[配置同步]")
            sync_cfg = Path("scripts/sync_config.py")
            print(f"  [{'✅' if sync_cfg.exists() else '❌'}] Config Sync Engine")
            print()
            print("快速命令:")
            print("  kaelis converge sync       一键同步所有模块")
            print("  kaelis converge audit      执行架构审计 (通、达、速、省)")
            print("  kaelis converge check      检查系统一致性")
        
        elif action == 'sync':
            scope = args.scope or 'all'
            
            if args.full:
                # 全量同步：后端+前端+测试+文档+Postman+数据库模型
                print("🔗 Full synchronization: backend + frontend + tests + docs + postman + models...")
                print()
                print("1️⃣  Synchronizing configuration...")
                subprocess.run(['python', 'scripts/sync_config.py', 'sync'])
                print()
                print("2️⃣  Generating backend routes...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'backend', '--output', 'api/routes'])
                print()
                print("3️⃣  Generating frontend types...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'frontend', '--output', 'web/frontend/src/api'])
                print()
                print("4️⃣  Generating tests...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'tests', '--output', 'tests', '--append'])
                print()
                print("5️⃣  Generating Postman collection...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'postman', '--output', 'postman'])
                print()
                print("6️⃣  Updating README.md API documentation...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'readme', '--readme', 'README.md'])
                print()
                if args.with_models:
                    print("7️⃣  Generating SQLAlchemy models...")
                    subprocess.run(['python', 'scripts/generate_models.py', '--output', 'api/models', '--factory-output', 'tests/factories'])
                print()
                print("✅ Full synchronization complete!")
            elif scope == 'all':
                print("🔗 Synchronizing all modules...")
                subprocess.run(['python', 'scripts/sync_config.py', 'sync'])
                subprocess.run(['python', 'scripts/codegen_v2.py', 'backend', '--output', 'api/routes'])
                subprocess.run(['python', 'scripts/codegen_v2.py', 'frontend', '--output', 'web/frontend/src/api'])
            elif scope == 'backend':
                print("🐍 Generating backend routes...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'backend', '--output', 'api/routes'])
            elif scope == 'frontend':
                print("⚛️ Generating frontend types...")
                subprocess.run(['python', 'scripts/codegen_v2.py', 'frontend', '--output', 'web/frontend/src/api'])
            elif scope == 'config':
                print("🔧 Synchronizing configuration...")
                subprocess.run(['python', 'scripts/sync_config.py', 'sync'])
        
        elif action == 'audit':
            print("🔍 Running Architecture Audit...")
            subprocess.run(['python', 'scripts/dependency_graph.py', 'audit'])
        
        elif action == 'check':
            print("📊 Checking system consistency...")
            subprocess.run(['python', 'scripts/dependency_graph.py', 'check'])
        
        elif action == 'affected':
            if not args.file:
                print("Error: --file required for affected action")
                return 1
            print(f"🔍 Analyzing impact of: {args.file}")
            subprocess.run(['python', 'scripts/dependency_graph.py', 'affected', args.file])
        
        elif action == 'validate':
            print("✅ Validating OpenAPI specification...")
            subprocess.run(['python', 'scripts/dependency_graph.py', 'validate', '--type', 'openapi'])
        
        elif action == 'verify':
            print("🔍 Running bidirectional verification...")
            subprocess.run(['python', 'scripts/dependency_graph.py', 'verify'])
        
        elif action == 'ops':
            # Phase 4: 运维契约化
            pass  # 由上面的 if action == 'ops' 处理
        
        elif action == 'knowledge':
            # Phase 5: 知识契约化
            pass  # 由 cmd_knowledge 处理
        
        return 0
    
    def cmd_codegen(self, args):
        """代码生成命令"""
        import subprocess
        
        target = args.target
        output = args.output
        
        cmd = ['python', 'scripts/codegen.py', target]
        if output:
            cmd.extend(['--output', output])
        
        subprocess.run(cmd)
        return 0
    
    def cmd_env(self, args):
        """Phase 6: 环境契约命令"""
        import subprocess
        
        action = args.env_action or 'verify'
        
        if action == 'verify':
            cmd = ['python', 'scripts/env_contract.py', 'verify']
            if args.fix:
                cmd.append('--fix')
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'snapshot':
            sub_action = args.env_sub_action or 'list'
            
            if sub_action == 'save':
                cmd = ['python', 'scripts/env_contract.py', 'snapshot', 'save']
                if args.name:
                    cmd.extend(['--name', args.name])
                result = subprocess.run(cmd)
                return result.returncode
            
            elif sub_action == 'list':
                result = subprocess.run(['python', 'scripts/env_contract.py', 'snapshot', 'list'])
                return result.returncode
            
            elif sub_action == 'diff':
                if not args.env_arg1 or not args.env_arg2:
                    print("Error: Two snapshot names required for diff")
                    return 1
                result = subprocess.run([
                    'python', 'scripts/env_contract.py', 'snapshot', 'diff',
                    args.env_arg1, args.env_arg2
                ])
                return result.returncode
        
        elif action == 'generate':
            gen_type = args.env_sub_action or 'devcontainer'
            if gen_type == 'devcontainer':
                result = subprocess.run(['python', 'scripts/env_contract.py', 'generate', 'devcontainer'])
                return result.returncode
        
        return 0
    
    def cmd_guard(self, args):
        """Phase 7: 护栏命令"""
        import subprocess
        
        action = args.guard_action or 'check'
        
        if action == 'check':
            cmd = ['python', 'scripts/kaelis_lsp.py', 'check']
            if args.file:
                cmd.extend(['--file', args.file])
            elif args.code:
                cmd.extend(['--code', args.code])
            else:
                print("Error: --file or --code required")
                return 1
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'lsp':
            sub_action = args.env_sub_action or 'start'
            cmd = ['python', 'scripts/kaelis_lsp.py']
            if args.mode == 'tcp':
                cmd.append('tcp')
            else:
                cmd.append('stdio')
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'analyze':
            result = subprocess.run(['python', 'scripts/guard_rules.py', 'analyze'])
            return result.returncode
        
        return 0
    
    def cmd_decision(self, args):
        """Phase 5 (重构): 决策契约命令"""
        import subprocess
        
        action = args.decision_action or 'list'
        
        if action == 'create':
            cmd = ['python', 'scripts/decision_engine.py', 'create']
            if args.auto:
                cmd.append('--auto')
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'activate':
            if not args.decision_id:
                print("Error: decision_id required")
                return 1
            result = subprocess.run(['python', 'scripts/decision_engine.py', 'activate', args.decision_id])
            return result.returncode
        
        elif action == 'verify':
            result = subprocess.run(['python', 'scripts/decision_engine.py', 'verify'])
            return result.returncode
        
        elif action == 'list':
            cmd = ['python', 'scripts/decision_engine.py', 'list']
            if args.status:
                cmd.extend(['--status', args.status])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'expired':
            result = subprocess.run(['python', 'scripts/decision_engine.py', 'expired'])
            return result.returncode
        
        elif action == 'migrate':
            if not args.decision_id:
                print("Error: adr_id required")
                return 1
            result = subprocess.run(['python', 'scripts/decision_engine.py', 'migrate', args.decision_id])
            return result.returncode
        
        elif action == 'deprecate':
            if not args.decision_id:
                print("Error: decision_id required")
                return 1
            cmd = ['python', 'scripts/decision_engine.py', 'deprecate', args.decision_id]
            if args.reason:
                cmd.extend(['--reason', args.reason])
            result = subprocess.run(cmd)
            return result.returncode
        
        return 0
    
    # ========================================================================
    # Phase 8: 运行时确定性基础设施
    # ========================================================================
    
    def cmd_runtime(self, args):
        """Phase 8: Runtime API 服务"""
        import subprocess
        
        action = args.runtime_action or 'start'
        
        if action == 'start':
            cmd = ['python', 'services/kaelis_runtime/main.py', '--host', args.host, '--port', str(args.port)]
            if args.reload:
                cmd.append('--reload')
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'status':
            print("🚀 Kaelis Runtime API 状态")
            print("=" * 60)
            print("\n[服务组件]")
            runtime_main = Path("services/kaelis_runtime/main.py")
            print(f"  [{'✅' if runtime_main.exists() else '❌'}] Runtime API Service")
            print("\n[API 端点]")
            print("  POST /v1/validate/code")
            print("  GET  /v1/validate/environment")
            print("  GET  /v1/slo/{service}")
            print("  GET  /health")
            print("  GET  /metrics")
            print("\n启动命令:")
            print("  kaelis runtime start")
        
        return 0
    
    def cmd_slo(self, args):
        """Phase 8: SLO 运行时校验"""
        import subprocess
        
        action = args.slo_action or 'check'
        
        if action == 'check':
            result = subprocess.run(['python', 'scripts/slo_runtime.py', 'check'])
