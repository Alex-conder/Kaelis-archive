        elif action == 'monitor':
            cmd = ['python', 'scripts/slo_runtime.py', 'monitor']
            if args.interval:
                cmd.extend(['--interval', str(args.interval)])
            result = subprocess.run(cmd)
            return result.returncode
        
        elif action == 'report':
            result = subprocess.run(['python', 'scripts/slo_runtime.py', 'report'])
            return result.returncode
        
        elif action == 'simulate':
            cmd = ['python', 'scripts/slo_runtime.py', 'simulate']
            if args.service:
                cmd.extend(['--service', args.service])
            result = subprocess.run(cmd)
            return result.returncode
        
        return 0
    
    def cmd_drift(self, args):
